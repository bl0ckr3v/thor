# VeChain Testnet Configuration
# Copy this file to .env and fill in your testnet private key

# Testnet private key (get testnet VET/VTHO from https://faucet.vecha.in/)
TESTNET_PRIVATE_KEY=your_testnet_private_key_here

# Optional: Custom testnet RPC URL
TESTNET_RPC_URL=https://testnet.veblocks.net

# Optional: Enable debug logging
DEBUG=true
